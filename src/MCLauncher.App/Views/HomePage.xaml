<UserControl x:Class="MCLauncher.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="720">
    <Grid>
        <!-- 左上角账号块：左侧皮肤头像（正版取官方皮肤，离线用默认皮肤），右侧账号名与类型；点击去账号页 -->
        <Button Style="{StaticResource AccountBlockButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="16,14,0,0"
                Command="{Binding OpenAccountsCommand}"
                ToolTip="管理账号">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" SnapsToDevicePixels="True">
                    <Image Source="{Binding AccountAvatar}"
                           Stretch="UniformToFill"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <StackPanel Margin="10,0,2,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountName}"
                               FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding AccountTypeText}"
                               Margin="0,2,0,0"
                               FontSize="11" Foreground="#B3FFFFFF"/>
                </StackPanel>
            </StackPanel>
        </Button>

        <!-- 启动公告：贴在账号块下方，窄卡片样式，不占整行 -->
        <!-- 启动输出出现时收起公告，避免默认窗口尺寸下两块内容互相遮挡 -->
        <Border Width="300"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,76,0,0"
                Background="#99000000" CornerRadius="6" Padding="10,9">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="{Binding DataContext.HasNotice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLaunchOutput}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding DataContext.NoticeTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding DataContext.NoticeMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="0,4,0,0"
                           FontSize="11" Foreground="#CCFFFFFF"
                           TextWrapping="Wrap" MaxHeight="80"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SkinButton}" Content="查看详情"
                            Width="76" Height="24" FontSize="11"
                            Visibility="{Binding DataContext.HasNoticeUrl, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.OpenNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Style="{StaticResource SkinButton}" Content="知道了"
                            Width="62" Height="24" FontSize="11" Margin="6,0,0,0"
                            Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 启动输出：点击启动后才出现，垂直居中（公告此时已收起，不会重叠） -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,0,0,120" Width="560" MaxHeight="330"
                    Visibility="{Binding HasLaunchOutput, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="8" Padding="10,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#CC000000"/>
                        <Style.Triggers>
                            <!-- 启动失败：面板整体变红，几秒后随面板一起收起 -->
                            <DataTrigger Binding="{Binding IsLaunchFailed}" Value="True">
                                <Setter Property="Background" Value="#CC5A1212"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}"
                               Margin="2,0,2,6"
                               FontSize="13" FontWeight="SemiBold" Foreground="White"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBox x:Name="LaunchOutputBox"
                             Text="{Binding LaunchOutput, Mode=OneWay}"
                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#D4D4D4"
                             FontFamily="Consolas, Courier New, 宋体"
                             FontSize="12"
                             Height="130"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextChanged="OnLaunchOutputChanged"/>
                </StackPanel>
            </Border>
            <ProgressBar Margin="0,8,0,0" Height="6" Minimum="0" Maximum="1"
                         Value="{Binding Progress, Mode=OneWay}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLaunchFailed}" Value="True">
                                <Setter Property="Foreground" Value="#E0575D"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding LaunchSpeedText}"
                       Style="{StaticResource SpeedText}"
                       Foreground="#B3FFFFFF" HorizontalAlignment="Left" Margin="2,4,0,0"/>
            <ItemsControl ItemsSource="{Binding LaunchFiles}" Margin="0,2,0,0"
                          ItemTemplate="{StaticResource DownloadFileRowDarkTemplate}"/>
        </StackPanel>

        <!-- 更新游戏：先检查本体文件 / 加载器 / 已安装模组，勾选后一键升级 -->
        <Grid Background="#66000000" Panel.ZIndex="30"
              Visibility="{Binding IsUpdateDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="460" MaxHeight="560" Background="White" CornerRadius="8" Padding="18,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#D8D8D8" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="更新游戏" FontSize="15" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    <TextBlock Text="{Binding SelectedVersion.Display}" Margin="0,4,0,0"
                               FontSize="11" Foreground="#7A7A7A" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="{Binding UpdateStatus}" Margin="0,12,0,0"
                               FontSize="12" Foreground="#5A5A5A" TextWrapping="Wrap"/>

                    <!-- 检查结果：可升级项默认全部勾选 -->
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding HasUpdateCheckResult, Converter={StaticResource BoolToVis}}">
                        <Border Background="#F6F7F9" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <CheckBox Content="游戏本体文件" FontSize="12" FontWeight="SemiBold"
                                          Foreground="#1A1A1A"
                                          IsChecked="{Binding IncludeBodyUpdate, Mode=TwoWay}"
                                          IsEnabled="{Binding HasBodyUpdate}"/>
                                <TextBlock Text="{Binding BodyUpdateText}" Margin="22,3,0,0"
                                           FontSize="11.5" Foreground="#6A6A6A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F6F7F9" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                            <StackPanel>
                                <CheckBox Content="模组加载器" FontSize="12" FontWeight="SemiBold"
                                          Foreground="#1A1A1A"
                                          IsChecked="{Binding IncludeLoaderUpdate, Mode=TwoWay}"
                                          IsEnabled="{Binding HasLoaderUpdate}"/>
                                <TextBlock Text="{Binding LoaderUpdateText}" Margin="22,3,0,0"
                                           FontSize="11.5" Foreground="#6A6A6A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F6F7F9" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="已安装模组" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#1A1A1A"/>
                                <TextBlock Text="{Binding ModsUpdateText}" Margin="0,3,0,0"
                                           FontSize="11.5" Foreground="#6A6A6A" TextWrapping="Wrap"/>

                                <ScrollViewer MaxHeight="150" Margin="0,4,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasModUpdates, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding ModUpdates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="0,2,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                                   Foreground="#1A1A1A"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding VersionText}" FontSize="10.5"
                                                                   Foreground="#7A7A7A"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ProgressBar Height="6" Margin="0,12,0,0" Minimum="0" Maximum="1"
                                 Value="{Binding UpdateProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsCheckingUpdate}"
                                 Visibility="{Binding IsUpdateBusy, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{Binding UpdateSpeedText}" Style="{StaticResource SpeedText}"/>

                    <ItemsControl ItemsSource="{Binding UpdateFiles}" Margin="0,4,0,0"
                                  ItemTemplate="{StaticResource DownloadFileRowTemplate}"
                                  Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{Binding UpdateResult}" Margin="0,6,0,0"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding HasUpdateResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2F6FB6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateResultFailed}" Value="True">
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Width="96" Height="28" FontSize="12" Content="一键升级"
                                Command="{Binding UpgradeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SkinButton}"/>
                            </Button.Style>
                        </Button>
                        <Button Width="76" Height="28" FontSize="12" Content="关闭" Margin="8,0,0,0"
                                Command="{Binding CloseUpdateDialogCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SkinButton}">
                                    <Style.Triggers>
                                        <!-- 检查/升级进行中不允许关闭弹窗 -->
                                        <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 原版右下角控件区：列宽 145/16/92、行高 31/10/31/16/30、右/下边距 37/33 -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,37,33">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="92"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="31"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="31"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding LaunchCommand}"
                    Content="启动游戏"
                    FontSize="20" FontWeight="Bold"/>

            <Button Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding CompleteCommand}"
                    Content="更新游戏"
                    FontSize="13"
                    ToolTip="检查本体文件、加载器与模组并可一键升级"/>

            <Button Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource SkinButton}"
                    Command="{Binding SettingsCommand}"
                    Content="设置"
                    FontSize="13"/>

            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Left">
                <ComboBox Width="180" Height="30"
                          VerticalAlignment="Center"
                          FontSize="14" Foreground="#1A1A1A"
                          ItemsSource="{Binding Versions}"
                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          ToolTip="选择要启动的版本"/>
                <Button Style="{StaticResource CreditLink}"
                        Command="{Binding OpenFolderCommand}"
                        Content="打开目录"
                        FontSize="15"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
