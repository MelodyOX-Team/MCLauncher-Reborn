<UserControl x:Class="MCLauncher.App.Views.ConnectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="720">
    <UserControl.Resources>
        <Style x:Key="MethodCard" TargetType="Button">
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="BorderBrush" Value="#E2E6EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF4FB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BBD2EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#4A4A4A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="SmallListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#5A5A5A"/>
        </Style>

        <DataTemplate x:Key="LineTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource HintText}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Content="← 更换方式" Command="{Binding BackCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource SkinButton}" Width="96" Height="26" FontSize="12"
                    Visibility="{Binding IsMethodPage, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 公共实例选择 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="实例" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Column="1" Margin="8,0,0,0" Width="220" Height="26" FontSize="12"
                          ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                          DisplayMemberPath="Display"/>
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="#8A8A8A"
                           Text="{Binding SelectedInstanceSummary}" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <Grid Grid.Row="1">
                <!-- ==================== 方式选择 ==================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsChoosePage, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Button Style="{StaticResource MethodCard}" Command="{Binding ShowDirectCommand}"
                                AutomationProperties.Name="好友直连">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="#4A6FA5" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="好友直连" FontSize="14" FontWeight="SemiBold"/>
                                        <Border Background="#EDF5EA" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock Text="无需第三方账号" FontSize="10" Foreground="#3F7A46"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="公网 IPv6、路由器 UPnP 或同一局域网直连。房主开好局域网世界后生成邀请码，好友粘贴即可自动进服。"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource MethodCard}" Command="{Binding ShowFrpCommand}"
                                AutomationProperties.Name="樱花穿透">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="#B26A00" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="樱花穿透" FontSize="14" FontWeight="SemiBold"/>
                                        <Border Background="#FFF3E0" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock Text="需自备访问密钥" FontSize="10" Foreground="#B26A00"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="用樱花穿透官方 frpc 把本地世界映射到公网。适合没有公网 IPv6、路由器也不支持 UPnP 的玩家。"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource MethodCard}" Command="{Binding ShowTerracottaCommand}"
                                AutomationProperties.Name="陶瓦联机">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="#7A5AA0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="陶瓦联机" FontSize="14" FontWeight="SemiBold"/>
                                        <Border Background="#F1EDF8" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock Text="房间码 · 独立开源" FontSize="10" Foreground="#7A5AA0"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="基于官方开源项目 burningtnt/Terracotta（AGPL-3.0）。下载并校验官方工具后，创建或加入房间即可。"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <TextBlock Text="加入好友的世界" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"/>

                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                                   Text="粘贴好友发来的直连邀请（MCLR-DIRECT-1 开头），会自动匹配同版本实例并启动游戏。"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Height="46" FontSize="12" Padding="6,4"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding JoinInviteText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Style="{StaticResource SkinButton}"
                                    Content="检测并加入" Width="96" Height="28" FontSize="12"
                                    Margin="8,0,0,0" VerticalAlignment="Top"
                                    Command="{Binding JoinDirectCommand}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,4"
                                   Text="或直接填写地址（樱花穿透远程地址、陶瓦地址或其他服务器）。"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Height="26" FontSize="12" Padding="6,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding JoinAddressText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="host 或 host:port，例如 play.example.com:25565"/>
                            <Button Grid.Column="1" Style="{StaticResource SkinButton}"
                                    Content="启动并加入" Width="96" Height="26" FontSize="12"
                                    Margin="8,0,0,0"
                                    Command="{Binding JoinAddressCommand}"/>
                        </Grid>

                        <TextBlock Text="{Binding JoinStatusText}" Style="{StaticResource StatusText}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== 好友直连 ==================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsDirectPage, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="房主先进入世界，在游戏里选择「对局域网开放」，然后刷新端口并开启房间。"
                                   Margin="0,0,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="局域网端口" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Width="80" Height="26" Margin="8,0,0,0"
                                     FontSize="12" Padding="6,0" VerticalContentAlignment="Center"
                                     Text="{Binding LanPortText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Style="{StaticResource SkinButton}"
                                    Content="刷新检测" Width="76" Height="26" FontSize="12"
                                    Margin="6,0,0,0" Command="{Binding DetectPortCommand}"/>
                            <CheckBox Grid.Column="3" Content="尝试 UPnP 映射" Margin="12,0,0,0"
                                      VerticalAlignment="Center" FontSize="12"
                                      IsChecked="{Binding UseUpnp, Mode=TwoWay}"/>
                            <TextBox Grid.Column="4" Height="26" Margin="12,0,0,0"
                                     FontSize="12" Padding="6,0" VerticalContentAlignment="Center"
                                     Text="{Binding PublicAddress, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="手动映射时填写路由器 WAN 公网 IPv4；没有可留空"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="右侧输入框可选：路由器已手动把对外端口映射到本机时，填写公网 IPv4。端口请填游戏里「对局域网开放」显示的端口。"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource SkinButton}" Content="开启房间"
                                    Width="88" Height="28" FontSize="12"
                                    Command="{Binding StartDirectCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="关闭房间"
                                    Width="88" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding StopDirectCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="刷新网络"
                                    Width="88" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding RefreshNetworkCommand}"/>
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="11" Foreground="#8A8A8A"
                                       Text="{Binding DirectConnectionsText}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding DirectStatus}" Style="{StaticResource StatusText}"/>

                        <TextBlock Text="邀请码" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"
                                   Visibility="{Binding IsDirectHosting, Converter={StaticResource BoolToVis}}"/>
                        <Grid Visibility="{Binding IsDirectHosting, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Height="44" IsReadOnly="True" FontSize="11"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding DirectInvite, Mode=OneWay}"/>
                            <Button Grid.Column="1" Style="{StaticResource SkinButton}" Content="复制邀请"
                                    Width="80" Height="26" FontSize="12" Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding CopyDirectInviteCommand}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding DirectEndpoints}" Margin="0,6,0,0"
                                      ItemTemplate="{StaticResource LineTemplate}"/>
                        <ItemsControl ItemsSource="{Binding DirectMessages}" Margin="0,4,0,0"
                                      ItemTemplate="{StaticResource LineTemplate}"/>

                        <TextBlock Text="本机网络" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding NetworkStatus}" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding NetworkLines}" ItemTemplate="{StaticResource LineTemplate}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== 樱花穿透 ==================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsFrpPage, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                                   Text="填写樱花穿透访问密钥（natfrp.com → 用户信息 → 访问密钥）即可读取账号里的隧道，也能直接在启动器里新建 / 删除。frpc 由启动器自动下载官方版本。"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="访问密钥" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Height="26" Margin="8,0,0,0" FontSize="12"
                                     Padding="6,0" VerticalContentAlignment="Center"
                                     Text="{Binding FrpAccessKey, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="刷新隧道" Width="82" Height="26" Margin="8,0,0,0"
                                    FontSize="12" Style="{StaticResource SkinButton}"
                                    Command="{Binding LoadFrpTunnelsCommand}"/>
                        </Grid>

                        <TextBlock Text="{Binding FrpTunnelStatus}" Style="{StaticResource HintText}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <Grid Margin="0,10,0,4">
                            <TextBlock Text="我的隧道" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="新建隧道" Width="82" Height="26" FontSize="12"
                                        Style="{StaticResource SkinButton}"
                                        Command="{Binding OpenTunnelEditorCommand}"/>
                            </StackPanel>
                        </Grid>

                        <ListBox Height="132" Style="{StaticResource SmallListBox}"
                                 ItemsSource="{Binding FrpTunnels}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center" Margin="2,0,8,0"
                                                  Cursor="Hand"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#8A9099"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StateText}" FontSize="10" Foreground="#8A9099"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="删除" Width="48" Height="24" FontSize="11"
                                                    Style="{StaticResource SkinButton}"
                                                    Command="{Binding DataContext.DeleteTunnelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ProgressBar Height="3" Margin="0,4,0,0" IsIndeterminate="True"
                                     Visibility="{Binding IsFrpBusy, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#8A8A8A" TextWrapping="Wrap">
                            <Run Text="勾选要穿透的隧道（可同时勾选多条，例如 Minecraft TCP + 语音模组 UDP），然后点「启动穿透」。"/>
                            <Run Text=" " Foreground="#BBBBBB"/>
                            <Run Text="封禁或离线状态的隧道无法启动。" Foreground="#BBBBBB"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource SkinButton}" Content="启动穿透"
                                    Width="88" Height="28" FontSize="12"
                                    Command="{Binding StartFrpCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="停止"
                                    Width="72" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding StopFrpCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="下载 / 校验 frpc"
                                    Width="118" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding InstallFrpCommand}"/>
                        </StackPanel>

                        <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="True"
                                     Visibility="{Binding IsFrpInstalling, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{Binding FrpStatusText}" Style="{StaticResource StatusText}"/>
                        <TextBlock Text="{Binding FrpPreparationHint}" Style="{StaticResource HintText}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="远程地址" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Height="26" Margin="8,0,0,0" IsReadOnly="True"
                                     FontSize="12" Padding="6,0" VerticalContentAlignment="Center"
                                     Text="{Binding FrpRemoteAddress, Mode=OneWay}"/>
                            <Button Grid.Column="2" Style="{StaticResource SkinButton}" Content="复制"
                                    Width="64" Height="26" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding CopyFrpAddressCommand}"/>
                        </Grid>

                        <TextBlock Text="frpc 日志" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"/>
                        <ListBox Height="110" Style="{StaticResource SmallListBox}"
                                 ItemsSource="{Binding FrpLogs}"
                                 ItemTemplate="{StaticResource LineTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== 陶瓦联机 ==================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsTerracottaPage, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                                   Text="陶瓦联机是独立开源项目 burningtnt/Terracotta（AGPL-3.0）。启动器只下载并校验官方工具，不修改或重打包。房主需先在游戏里「对局域网开放」。"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="昵称" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Width="140" Height="26" Margin="8,0,0,0" FontSize="12"
                                     Padding="6,0" VerticalContentAlignment="Center"
                                     Text="{Binding TcPlayerName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Style="{StaticResource SkinButton}" Content="下载 / 校验工具"
                                    Width="118" Height="26" FontSize="12" Margin="8,0,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding InstallTcCommand}"/>
                        </Grid>

                        <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="1"
                                     Value="{Binding TcInstallProgress, Mode=OneWay}"
                                     Visibility="{Binding IsTcInstalling, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding TcSpeedText}" FontSize="11" Foreground="#8A8A8A"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding IsTcSpeedVisible, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{Binding TcStatusText}" Style="{StaticResource StatusText}"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Button Style="{StaticResource SkinButton}" Content="创建房间"
                                        Width="88" Height="28" FontSize="12" HorizontalAlignment="Left"
                                        Command="{Binding StartTcHostCommand}"/>
                                <TextBlock Text="房间码（发给好友）" Style="{StaticResource HintText}" Margin="0,6,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Height="26" IsReadOnly="True" FontSize="12"
                                             Padding="6,0" VerticalContentAlignment="Center"
                                             Text="{Binding TcRoom, Mode=OneWay}"/>
                                    <Button Grid.Column="1" Style="{StaticResource SkinButton}" Content="复制"
                                            Width="56" Height="26" FontSize="12" Margin="6,0,0,0"
                                            Command="{Binding CopyTcRoomCommand}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Height="26" FontSize="12" Padding="6,0"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding TcJoinCode, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="U/XXXX-XXXX-XXXX-XXXX"/>
                                    <Button Grid.Column="1" Style="{StaticResource SkinButton}" Content="加入房间"
                                            Width="80" Height="26" FontSize="12" Margin="6,0,0,0"
                                            Command="{Binding JoinTcCommand}"/>
                                </Grid>
                                <TextBlock Text="连接地址" Style="{StaticResource HintText}" Margin="0,6,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Height="26" IsReadOnly="True" FontSize="12"
                                             Padding="6,0" VerticalContentAlignment="Center"
                                             Text="{Binding TcUrl, Mode=OneWay}"/>
                                    <Button Grid.Column="1" Style="{StaticResource SkinButton}" Content="复制"
                                            Width="56" Height="26" FontSize="12" Margin="6,0,0,0"
                                            Command="{Binding CopyTcUrlCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Button Style="{StaticResource SkinButton}" Content="关闭陶瓦房间"
                                Width="110" Height="26" FontSize="12" Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding StopTcCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 新建隧道覆盖层 -->
        <Grid Grid.RowSpan="2" Background="#66000000" Panel.ZIndex="20"
              Visibility="{Binding IsTunnelEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="430" Background="White" CornerRadius="8" Padding="18,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#D8D8D8" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="新建 TCP 隧道" FontSize="15" FontWeight="SemiBold"/>
                        <Button Content="×" HorizontalAlignment="Right" Width="24" Height="24"
                                FontSize="14" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Command="{Binding CloseTunnelEditorCommand}"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Height="26" Margin="8,0,0,0" FontSize="12"
                                 Padding="6,0" VerticalContentAlignment="Center"
                                 Text="{Binding NewTunnelName, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="节点" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" Height="26" Margin="8,0,0,0" FontSize="12"
                                  ItemsSource="{Binding FrpNodes}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedTunnelNode, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="本地端口" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" Height="26" Margin="8,0,0,0" FontSize="12"
                                  ItemsSource="{Binding FrpLocalPorts}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedLocalPort, Mode=TwoWay}"
                                  ToolTip="本机正在监听的 TCP 端口，选中会自动填入右侧输入框"/>
                        <TextBox Grid.Column="2" Width="62" Height="26" Margin="8,0,0,0" FontSize="12"
                                 Padding="6,0" VerticalContentAlignment="Center"
                                 Text="{Binding NewTunnelPort, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="也可以直接输入端口"/>
                        <Button Grid.Column="3" Content="重新扫描" Width="72" Height="26" Margin="6,0,0,0"
                                FontSize="12" Style="{StaticResource SkinButton}"
                                Command="{Binding ScanLocalPortsCommand}"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Height="26" Margin="8,0,0,0" FontSize="12"
                                 Padding="6,0" VerticalContentAlignment="Center"
                                 Text="{Binding NewTunnelNote, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="只给好友联机可以随便选节点；如果服务器要公开发布（论坛、群、服务器列表），必须选带「多线」标记的节点，否则可能被封禁。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="创建" Width="72" Height="28" FontSize="12"
                                Style="{StaticResource SkinButton}"
                                Command="{Binding CreateTunnelCommand}"/>
                        <Button Content="取消" Width="72" Height="28" FontSize="12" Margin="8,0,0,0"
                                Style="{StaticResource SkinButton}"
                                Command="{Binding CloseTunnelEditorCommand}"/>
                        <TextBlock Text="{Binding CreateTunnelStatus}" Style="{StaticResource HintText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
