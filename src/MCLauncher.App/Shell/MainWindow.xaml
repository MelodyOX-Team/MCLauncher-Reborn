<Window x:Class="MCLauncher.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:MCLauncher.App.ViewModels"
        xmlns:views="clr-namespace:MCLauncher.App.Views"
        mc:Ignorable="d"
        Title="MCLauncher-reborn"
        Icon="pack://application:,,,/MCLauncher-Reborn.ico"
        SizeToContent="Manual"
        MinWidth="720" MinHeight="450"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        AllowDrop="True"
        DragEnter="OnFileDragEnter"
        DragOver="OnFileDragOver"
        DragLeave="OnFileDragLeave"
        Drop="OnFileDrop"
        SourceInitialized="OnSourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Background>
        <!-- 必须用程序集绝对路径：本文件位于 Shell\ 子目录，相对路径会被解析成 shell/assets/... -->
        <ImageBrush ImageSource="pack://application:,,,/Assets/default-bg.jpg" Stretch="Fill"/>
    </Window.Background>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
            <views:VersionsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
            <views:AccountsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectViewModel}">
            <views:ConnectPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LaunchLogViewModel}">
            <views:LaunchLogPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstanceManageViewModel}">
            <views:InstanceManagePage/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部横向导航 ===== -->
        <Border Grid.Row="0" Background="{StaticResource NavPanelBrush}" Padding="8,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavBarItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         VerticalAlignment="Center"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空白拖动区：按住即可移动窗口 -->
                <Border Grid.Column="1"
                        Background="Transparent"
                        MouseLeftButtonDown="OnDragMove"/>

                <!-- 窗口按钮：最小化始终显示；不提供最大化；关闭贴角 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WindowButton}"
                            Width="38" Height="26"
                            Click="OnMinimizeClick"
                            ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseButton}"
                            Width="38" Height="26"
                            Click="OnCloseClick"
                            ToolTip="关闭">
                        <TextBlock Text="&#x2715;" FontFamily="Segoe UI Symbol, Segoe UI" FontSize="14">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 内容区：页面 + 右侧更新抽屉 ===== -->
        <Grid Grid.Row="1">
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Margin" Value="8,8,8,34"/>
                        <Setter Property="Background" Value="{StaticResource ContentPanelBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource ContentBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHomePage}" Value="True">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ContentControl Content="{Binding CurrentPage}"/>
            </Border>

            <!-- 更新抽屉：有更新时从右侧滑出，点正文直接下载，启动 5 秒后自动缩回 -->
            <Grid Width="336" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,14,0,0"
                  Panel.ZIndex="90"
                  Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">

                <Button x:Name="UpdateDrawer"
                        MinHeight="104"
                        Command="{Binding UpdateActionCommand}"
                        ToolTip="点击下载并更新启动器">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DrawerSurfaceButton}">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="336"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateDrawerOpen}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                    To="0" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                    To="336" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <StackPanel Margin="28,12,16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding UpdateTitle}"
                                       Foreground="#FFFFD400" FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <!-- 整块抽屉都可点，这里只是把「可点击更新」做成明确的操作提示 -->
                            <Border Grid.Column="1" Margin="10,0,0,0" Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="#26FFD400" BorderBrush="#66FFD400"
                                    BorderThickness="1" CornerRadius="9">
                                <TextBlock Text="更新 ›" Foreground="#FFFFD400" FontSize="11"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding UpdateMessage}"
                                   Foreground="#B3FFD400" FontSize="11.5" Margin="0,8,0,0"
                                   TextWrapping="Wrap" LineHeight="17" MaxHeight="72"/>
                    </StackPanel>
                </Button>

                <!-- 抽屉最左侧的 >：点击缩回右边缘 -->
                <Button Style="{StaticResource DrawerBarButton}"
                        Width="20" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Content="&gt;" FontSize="13" ToolTip="收起"
                        Visibility="{Binding IsUpdateDrawerOpen, Converter={StaticResource BoolToVis}}"
                        Command="{Binding CollapseUpdateDrawerCommand}"/>
            </Grid>

            <!-- 收起态：右边缘的小方块，点 < 抽出抽屉 -->
            <Button Width="26" Height="56"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,14,0,0"
                    Panel.ZIndex="91"
                    Style="{StaticResource DrawerSurfaceButton}"
                    ToolTip="查看更新"
                    Visibility="{Binding IsUpdateDrawerCollapsed, Converter={StaticResource BoolToVis}}"
                    Command="{Binding OpenUpdateDrawerCommand}">
                <TextBlock Text="&lt;" FontSize="15" Foreground="#FFFFD400"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- ===== 左下角署名：悬停变蓝，点击打开项目主页 ===== -->
        <Button Grid.Row="1"
                Style="{StaticResource CreditLink}"
                Click="OnCreditClick"
                Content="MineCraft Launcher 6.0 Reborn by 忘却的旋律"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="8,0,0,7"/>

        <!-- ===== 状态栏文字：限制宽度并裁剪，避免长文本盖住左下角署名 ===== -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   Style="{StaticResource OverlayText}"
                   FontSize="12"
                   MaxWidth="380"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,12,8"/>

        <!-- ===== 首次启动的初始化设置：完成前覆盖整个窗口 ===== -->
        <views:SetupView Grid.RowSpan="2" Panel.ZIndex="110"
                         DataContext="{Binding Setup}"
                         Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"/>

        <!-- ===== 拖入文件时的提示遮罩：松开即开始识别 ===== -->
        <Border x:Name="DropHint" Grid.RowSpan="2" Panel.ZIndex="140"
                Background="#66000000" IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border Width="430" Height="190"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F5FFFFFF" CornerRadius="10"
                    BorderBrush="#FFD400" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                               Foreground="#C9A400" HorizontalAlignment="Center"/>
                    <TextBlock Text="松开以安装到启动器" FontSize="15" FontWeight="SemiBold"
                               Foreground="#2A2A2A" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="支持模组 / 资源包 / 光影包 / 整合包" FontSize="11.5"
                               Foreground="#7A7A7A" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== 拖放安装：选择实例后把文件复制到对应资源目录 ===== -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="95" Background="#66000000"
              DataContext="{Binding Drop}"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="580" MaxHeight="540" Background="White" CornerRadius="8" Padding="18,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#D8D8D8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="拖入的文件" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Title}" Margin="0,8,0,0"
                                       FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#2A2A2A" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Summary}" Margin="0,4,0,0"
                                       FontSize="12" Foreground="#5A5A5A" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Note}" Margin="0,6,0,0"
                                       FontSize="12" Foreground="#B26A00" TextWrapping="Wrap"
                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="文件" Margin="0,12,0,4" FontSize="13" Foreground="#5A5A5A"/>
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F7F8FA" CornerRadius="4"
                                                Padding="8,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" FontSize="12.5"
                                                               Foreground="#2A2A2A"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Note}" FontSize="10.5"
                                                               Foreground="#9A5B00" TextWrapping="Wrap"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding KindText}"
                                                           FontSize="11" Foreground="#5A5A5A"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding HasInstallableFiles, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="安装到实例" Margin="0,12,0,4" FontSize="13" Foreground="#5A5A5A"/>
                                <ListBox ItemsSource="{Binding Instances}"
                                         SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                         MaxHeight="150" BorderBrush="#E2E6EC" BorderThickness="1"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,2">
                                                <TextBlock Text="{Binding Display}" FontSize="12.5"
                                                           Foreground="#2A2A2A"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                           Foreground="#7A7A7A"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="{Binding DestinationText}" Margin="0,8,0,0"
                                           FontSize="11.5" Foreground="#3A6EA5" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0"
                                       FontSize="12" Foreground="#5A5A5A" TextWrapping="Wrap"
                                       MinHeight="16"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource SkinButton}" Content="{Binding CloseButtonText}"
                                Width="76" Height="28" FontSize="13"
                                Command="{Binding CloseCommand}"
                                IsEnabled="{Binding CanClose}"/>
                        <Button Style="{StaticResource SkinButton}" Content="安装"
                                Width="76" Height="28" FontSize="13" Margin="8,0,0,0"
                                Command="{Binding InstallCommand}"
                                IsEnabled="{Binding CanInstall}"
                                Visibility="{Binding HasInstallableFiles, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 崩溃界面：游戏异常退出后覆盖整个窗口 ===== -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="100" Background="#66000000"
              DataContext="{Binding Crash}"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="660" Height="420" Background="White" CornerRadius="8" Padding="16,12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#D8D8D8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部提示 -->
                    <Border Grid.Row="0" Background="#FDECEA" CornerRadius="6" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                       Foreground="#D0564B" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#A63A30"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#8A5A55"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 错误摘要 / 可能的原因 -->
                    <ScrollViewer Grid.Row="1" MaxHeight="132" Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding Summary}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#3A3A3A" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="可能的原因" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#6A6A6A" Margin="2,0,0,4"/>

                            <ItemsControl ItemsSource="{Binding Causes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8F9FB" CornerRadius="4"
                                                Padding="8,6" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="#A63A30"/>
                                                <TextBlock Text="{Binding Advice}" FontSize="10.5"
                                                           Foreground="#5A5A5A" TextWrapping="Wrap"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 崩溃日志 -->
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="崩溃日志" FontSize="11"
                                   FontWeight="SemiBold" Foreground="#6A6A6A" Margin="2,0,0,4"/>
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                 Background="#F7F8FA" BorderBrush="#E2E6EC" BorderThickness="1"
                                 FontFamily="Consolas, Courier New, 宋体" FontSize="10.5"
                                 Padding="6" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 MinHeight="90"/>
                    </DockPanel>

                    <!-- 操作 -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Hint}" FontSize="10.5" Foreground="#7A7A7A"
                                   HorizontalAlignment="Left" ToolTip="{Binding Hint}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="150"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SkinButton}" Content="打开崩溃报告"
                                    Width="104" Height="28" FontSize="12"
                                    Command="{Binding OpenReportCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="打开实例目录"
                                    Width="104" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding OpenFolderCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="复制日志"
                                    Width="82" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding CopyLogCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="重新启动"
                                    Width="82" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding RestartCommand}"/>
                            <Button Style="{StaticResource SkinButton}" Content="关闭"
                                    Width="66" Height="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding CloseCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
